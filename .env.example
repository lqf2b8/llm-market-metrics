# Copy to .env (never commit .env) and fill in.

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# https://console.anthropic.com/settings/keys (memo service only)
ANTHROPIC_API_KEY=

# local = JSON Lines under ./data/raw ; bigquery = the raw dataset in GCP_PROJECT
SINK=local

# Needed for BigQuery (SINK=bigquery or docker-compose.bigquery.yml)
GCP_PROJECT=
BQ_RAW_DATASET=raw
BQ_LOCATION=US
# Cloud Run region for deploys (infra/gcp/bootstrap.sh)
GCP_REGION=us-central1

# Uncomment to run every docker compose command against BigQuery instead of DuckDB.
# Windows separates the files with ";", macOS and Linux with ":".
# COMPOSE_FILE=docker-compose.yml;docker-compose.bigquery.yml
