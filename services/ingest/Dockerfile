FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install ".[bigquery]" \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /data && chown app /data

USER app
ENTRYPOINT ["python", "-m", "ingest"]
CMD ["daily"]
